---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingButtons from '../../components/FloatingButtons.astro';
import { SITE, FAQ } from '../../data';

const title = 'Domande frequenti — Studio Oicos · Ragusa';
const description =
  'Le risposte dello Studio Oicos alle domande più frequenti su amministrazione condominiale, documenti, contabilità, morosità, compensi e detrazioni.';
const canonical = `${SITE.url}/faq/`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const faqLeft = FAQ.slice(0, 4);
const faqRight = FAQ.slice(4);
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="faq-page">
    <section class="sec faq">
      <span class="wc" style="width:170px;height:130px;top:12%;left:7%"></span>
      <span class="geomark" style="width:54px;height:54px;top:18%;right:9%">
        <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="22" stroke="rgba(95,117,142,.32)" stroke-width="1.2"/><circle cx="24" cy="24" r="13" stroke="rgba(203,161,53,.42)" stroke-width="1.2"/><circle cx="24" cy="24" r="4" fill="rgba(203,161,53,.42)"/></svg>
      </span>
      <div class="wrap">
        <div class="head rv">
          <div class="eyebrow"><span class="bar"></span><span class="mono">Domande frequenti</span><span class="bar"></span></div>
          <h1>Le risposte alle domande <b>più comuni.</b></h1>
          <p>Informazioni chiare sui temi che ci vengono richiesti più spesso. Per una situazione specifica, puoi sempre <a href="/contatti/">contattare lo studio</a>.</p>
        </div>
        <div class="faq-list rv">
          <div class="faq-col">
            {faqLeft.map((item) => (
              <details class="faq-item"><summary>{item.q}</summary><div class="faq-a">{item.a}</div></details>
            ))}
          </div>
          <div class="faq-col">
            {faqRight.map((item) => (
              <details class="faq-item"><summary>{item.q}</summary><div class="faq-a">{item.a}</div></details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingButtons />
</BaseLayout>

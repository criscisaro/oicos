---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorldGeo from '../components/WorldGeo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import { SITE, CONTACT } from '../data';

const title = 'Studio Oicos — Amministratori condominiali · Ragusa';
const description =
  'Studio Oicos amministra condomìni di ogni tipologia in provincia di Ragusa da oltre trent\'anni: gestione trasparente, contabilità chiara e servizi dedicati.';
const canonical = `${SITE.url}/`;

const paths = [
  {
    n: '01',
    href: '/studio/',
    eyebrow: 'Lo studio',
    title: 'Esperienza e metodo.',
    description: 'Oltre trent’anni di amministrazione condominiale a Ragusa, con ordine, trasparenza e competenza.',
  },
  {
    n: '02',
    href: '/servizi/',
    eyebrow: 'Servizi',
    title: 'Una gestione completa.',
    description: 'Contabilità, assemblee, manutenzioni, sicurezza e tutela: un unico interlocutore per ogni esigenza.',
  },
  {
    n: '03',
    href: '/area-riservata/',
    eyebrow: 'Area riservata',
    title: 'Il condominio sempre con te.',
    description: 'Il portale dedicato a documenti, bilanci, scadenze e comunicazioni dello stabile.',
  },
  {
    n: '04',
    href: '/contatti/',
    eyebrow: 'Contatti',
    title: 'Parliamo del tuo condominio.',
    description: 'Contatta lo Studio Oicos per informazioni, assistenza o per richiedere un preventivo.',
  },
];
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <WorldGeo />
  <Header />

  <main>
    <section class="hero">
      <div class="hero-photo"></div>
      <div class="hero-fade"></div>
      <div class="wrap hero-inner">
        <div class="hero-text">
          <div class="hero-eyebrow"><span>Studio Oicos</span></div>
          <h1>Amministriamo condomìni <span>a Ragusa.</span></h1>
          <div><span class="chip">Da oltre trent'anni.</span></div>
          <div class="hero-actions">
            <a href="/contatti/" class="btn btn--solid">Richiedi un preventivo <span class="ar">→</span></a>
            <a href={`tel:${CONTACT.phoneHref}`} class="btn">Chiama lo studio</a>
          </div>
          <p class="hero-etym">«Oicos» viene dal greco <span class="gr">οἶκος</span>, «casa»: la stessa radice di <b>economia</b> — οἶκος (casa) + νόμος (regola), «le regole della casa». Amministrare un condominio è esattamente questo.</p>
        </div>
      </div>
    </section>

    <section class="sec home-intro">
      <span class="wc" style="width:175px;height:135px;top:9%;right:10%"></span>
      <div class="wrap">
        <div class="head rv">
          <div class="eyebrow"><span class="bar"></span><span class="mono">Studio Oicos</span><span class="bar"></span></div>
          <h2>Ogni edificio è una casa <b>da far funzionare.</b></h2>
          <p>Scopri lo studio, i servizi e gli strumenti dedicati ai condòmini attraverso le nuove pagine del sito.</p>
        </div>
        <div class="home-paths rv">
          {paths.map((path) => (
            <a class="home-path" href={path.href}>
              <span class="home-path-n">{path.n}</span>
              <span class="mono">{path.eyebrow}</span>
              <h2>{path.title}</h2>
              <p>{path.description}</p>
              <span class="home-path-link">Scopri <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingButtons />
</BaseLayout>
